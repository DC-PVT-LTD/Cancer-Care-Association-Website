# ==============================================================================
# CANCER CARE ASSOCIATION SRI LANKA - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env.local for local development.
# For production on CapRover, configure these in the CapRover App Dashboard -> App Configs -> Environmental Variables.
# NEVER commit production credentials or secrets to Git!

# ------------------------------------------------------------------------------
# 1. RUNTIME SERVER CONFIGURATION (Container Defaults)
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# ------------------------------------------------------------------------------
# 2. PUBLIC SITE METADATA & CANONICAL URL (Available to Client & Server)
# If updated, this can be provided during Docker build or as NEXT_PUBLIC_*
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://cancercaresl.org

# ------------------------------------------------------------------------------
# 3. OPTIONAL CONTACT INQUIRY DISPATCH (Runtime Server-Side Only)
# Configure either SMTP or Resend API in CapRover App Dashboard -> App Configs.
# ------------------------------------------------------------------------------
# Option A: SMTP Gateway (e.g. Gmail / Brevo / Sendgrid / Custom Mail Server)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@cancercaresl.org
SMTP_PASS=your_smtp_app_password_here
SMTP_FROM="Cancer Care Association" <notifications@cancercaresl.org>
CONTACT_RECEIVER_EMAIL=cancercaresl@gmail.com

# Option B: Resend Service API Key (Alternative to SMTP)
RESEND_API_KEY=re_1234567890abcdef_placeholder
